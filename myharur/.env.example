# Supabase Configuration
SUPABASE_URL=https://krfzaemoendekexglkfj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RS256 Key (Public Key ONLY — myharur CANNOT sign tokens)
