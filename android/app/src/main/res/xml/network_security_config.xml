<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. User-installed CA certificates are not trusted, so a device-level proxy or
     malicious certificate cannot read the app's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
